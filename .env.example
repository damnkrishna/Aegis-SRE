# ==============================================================================
# Aegis-SRE Configuration Template (100% Free Tier Compatible)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Diagnostic Brain (Choose ONE free option, or leave blank for rule engine)
# ------------------------------------------------------------------------------
# Option A: Local Ollama (100% free, runs locally on your PC, no internet/API key)
# Download from https://ollama.com and run: ollama run llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Option B: Groq Cloud API (Free tier: 30 requests/min, 14,400 req/day, no credit card)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Option C: Google Gemini API (Free tier: 15 req/min, 1,500 req/day, no credit card)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Telemetry & Observability (Runs locally via docker-compose, 100% free)
# ------------------------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TARGET_APP_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 3. Database & State Persistence (Built-in SQLite, zero configuration required)
# ------------------------------------------------------------------------------
AEGIS_DB_DIR=logs
DATABASE_URL=sqlite:///logs/aegis_sre.db

# ------------------------------------------------------------------------------
# 4. Human Operator Escalation Notifications (Optional)
# ------------------------------------------------------------------------------
# Create a free webhook in Discord (Channel Settings > Integrations > Webhooks)
# or Slack (Incoming WebHooks app). Leave blank to skip external notifications.
AEGIS_ESCALATION_WEBHOOK=

# ------------------------------------------------------------------------------
# 5. Kubernetes & Controller (Optional)
# ------------------------------------------------------------------------------
# Leave blank to use built-in safe simulation/mock mode for local development.
# In a real cluster, the in-cluster service account or ~/.kube/config is used automatically.
GO_CONTROLLER_URL=http://localhost:8080/api/v1/reconcile
